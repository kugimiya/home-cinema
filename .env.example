# Copy to .env and adjust paths/ports for your machine.

# Orchestrator
ORCHESTRATOR_PORT=8080
TORAPI_URL=http://torapi:8443
TORRSERVER_URL=http://torrserver:8090
# URL браузера для /stream (через nginx UI на :3000, не напрямую :8090)
TORRSERVER_PUBLIC_URL=http://localhost:3000
TORRENTS_SAVE_PATH=/torrents
TORRSERVER_DATA_PATH=/torrserver-data

# TorrServer performance (applied at orchestrator startup via GET→merge→SET)
TORRSERVER_CACHE_SIZE_MB=128
TORRSERVER_PRELOAD_CACHE=40
TORRSERVER_CONNECTIONS_LIMIT=40
TORRSERVER_READER_READ_AHEAD=95
TORRSERVER_LIST_TIMEOUT=45
TORRSERVER_PRIORITY_CONCURRENCY=4

# TorAPI optional HTTP proxy (for RuTracker etc.)
# PROXY_ADDRESS=
# PROXY_PORT=
# PROXY_USERNAME=
# PROXY_PASSWORD=

# Web (browser hits orchestrator via nginx proxy)
WEB_PORT=3000
VITE_API_BASE=

# Android / Android TV (LAN): replace localhost with your PC LAN IP, e.g. 192.168.1.5
# ORCHESTRATOR_PUBLIC_URL=http://192.168.1.5:3000
# TORRSERVER_PUBLIC_URL=http://192.168.1.5:3000
# mDNS discovery (_homecinema._tcp); may not work from Docker on Windows — app also scans subnet
# DISCOVERY_MDNS_ENABLED=true

# Browser playback / on-the-fly transcode (HLS via FFmpeg in orchestrator)
ORCHESTRATOR_PUBLIC_URL=http://localhost:3000
TRANSCODE_ENABLED=true
TRANSCODE_WORK_DIR=/tmp/transcode
TRANSCODE_MAX_SESSIONS=2
TRANSCODE_SESSION_TTL_SEC=300
TRANSCODE_ALLOW_HEVC_DIRECT=false

# Probe warm: Range prefetch of file heads for faster ffprobe (0 = disabled)
PROBE_WARM_BYTES=4194304
# Auto while watching: 0=manual only, N=next N video files, -1=all video in torrent
PROBE_WARM_FILES=2
# Library button: N=max un-warmed videos, -1=all video
PROBE_WARM_MANUAL_FILES=-1
PROBE_WARM_CONCURRENCY=1

# Service status bar: restart containers from UI (requires docker.sock on orchestrator)
SERVICE_RESTART_ENABLED=false
# DOCKER_CONTAINER_TORRSERVER=home-cinema-torrserver
# DOCKER_CONTAINER_TORAPI=home-cinema-torapi
# DOCKER_CONTAINER_ORCHESTRATOR=home-cinema-orchestrator
