# Copy to .env and adjust paths/ports for your machine.

# Orchestrator
ORCHESTRATOR_PORT=8080
TORAPI_URL=http://torapi:8443

TORRENT_ENGINE_URL=http://torrent-engine:8090
TORRENT_ENGINE_PUBLIC_URL=http://localhost:3000
TORRENT_ENGINE_LIST_TIMEOUT=45
TORRENT_ENGINE_PRIORITY_CONCURRENCY=4

# torrent-engine service (HTTP + libtorrent); env_file in docker-compose
# --- Docker Compose (recommended) ---
TORRENT_ENGINE_PORT=8090
TORRENT_ENGINE_HOST=0.0.0.0
TORRENT_ENGINE_SAVE_PATH=/torrents
TORRENT_ENGINE_LISTEN_HOST=0.0.0.0
TORRENT_ENGINE_LISTEN_PORT=6881
TORRENT_ENGINE_LISTEN_INTERFACES=eth0:6881
TORRENT_ENGINE_CONNECTIONS_LIMIT=500
TORRENT_ENGINE_UNCHOKE_SLOTS_LIMIT=20
TORRENT_ENGINE_MAX_CONNECTIONS_PER_TORRENT=100
TORRENT_ENGINE_MAX_UPLOAD_SLOTS_PER_TORRENT=4
TORRENT_ENGINE_CONNECTION_SPEED=30
TORRENT_ENGINE_DOWNLOAD_RATE_LIMIT=0
TORRENT_ENGINE_UPLOAD_RATE_LIMIT=0
TORRENT_ENGINE_ENABLE_DHT=true
TORRENT_ENGINE_ENABLE_LSD=false
TORRENT_ENGINE_ENABLE_UPNP=false
TORRENT_ENGINE_ENABLE_NATPMP=false
# With compose.macvlan.yml overlay, defaults flip to true and listen moves to eth1:6881

# --- Optional macvlan (LAN IP for torrent-engine, see compose.macvlan.yml) ---
# DOCKER_MACVLAN_PARENT=eno1
# DOCKER_LAN_SUBNET=192.168.1.0/24
# DOCKER_LAN_GATEWAY=192.168.1.1
# TORRENT_ENGINE_LAN_IP=192.168.1.50
# TORRENT_ENGINE_LISTEN_INTERFACES=eth1:6881
TORRENT_ENGINE_DHT_BOOTSTRAP_NODES=dht.libtorrent.org:25401,dht.transmissionbt.com:6881,router.bittorrent.com:6881
TORRENT_ENGINE_BT_PROTOCOL=0
TORRENT_ENGINE_ENCRYPTION=0
TORRENT_ENGINE_PEER_TURNOVER=4
TORRENT_ENGINE_PEER_TURNOVER_CUTOFF=90
TORRENT_ENGINE_PEER_TURNOVER_INTERVAL=300
TORRENT_ENGINE_QUEUEING_ENABLED=false
TORRENT_ENGINE_USER_AGENT=home-cinema/1.0
# TORRENT_ENGINE_PEER_FINGERPRINT=
# TORRENT_ENGINE_HANDSHAKE_CLIENT_VERSION=
TORRENT_ENGINE_LOG_LEVEL=INFO

# Transcoder service (HLS / quality scaling)
TRANSCODER_URL=http://transcoder:8091
TRANSCODER_ENABLED=true
TRANSCODER_PORT=8091

COMPLETE_SCOPE=active_only

# TorAPI optional HTTP proxy (for RuTracker etc.)
# PROXY_ADDRESS=
# PROXY_PORT=
# PROXY_USERNAME=
# PROXY_PASSWORD=

# Web (browser hits orchestrator via nginx proxy)
WEB_PORT=3000
VITE_API_BASE=
ORCHESTRATOR_PUBLIC_URL=http://localhost:3000

# Probe warm: Range prefetch for faster ffprobe (0 = disabled)
PROBE_WARM_BYTES=4194304
PROBE_WARM_FILES=2
PROBE_WARM_MANUAL_FILES=-1
PROBE_WARM_CONCURRENCY=1

# Transcode sessions (orchestrator)
TRANSCODE_ENABLED=true
TRANSCODE_WORK_DIR=/transcode
TRANSCODE_MAX_SESSIONS=4
TRANSCODE_SESSION_TTL_SEC=180
TRANSCODE_ALLOW_HEVC_DIRECT=false

# Optional: restart services from UI (requires docker socket mount)
SERVICE_RESTART_ENABLED=false
DISCOVERY_MDNS_ENABLED=false
