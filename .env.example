# Copy to .env and adjust paths/ports for your machine.

# Orchestrator
ORCHESTRATOR_PORT=8080
TORAPI_URL=http://torapi:8443
TORRSERVER_URL=http://torrserver:8090
TORRSERVER_PUBLIC_URL=http://localhost:8090
TORRENTS_SAVE_PATH=/torrents
TORRSERVER_DATA_PATH=/torrserver-data

# TorAPI optional HTTP proxy (for RuTracker etc.)
# PROXY_ADDRESS=
# PROXY_PORT=
# PROXY_USERNAME=
# PROXY_PASSWORD=

# Web (browser hits orchestrator via nginx proxy)
WEB_PORT=3000
VITE_API_BASE=
